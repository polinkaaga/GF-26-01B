  columns: 3,
  align: left,
  inset: 6pt,
  table.header([*Тип носителя*], [*Примеры*], [*Особенности*]),
  [Природные], [Память человека, камень, дерево], [Не нужны специальные устройства, но ограничены по объёму и сохранности],
  [Бумажные], [Книги, газеты, чертежи, рукописи], [Наглядны, могут храниться столетиями, но занимают много места],
